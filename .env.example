# Получи на https://my.telegram.org -> API development tools
TG_API_ID=0
TG_API_HASH=0

# Токен обычного бота от @BotFather
TG_BOT_TOKEN=0

# Твой личный Telegram user_id (узнать можно у @userinfobot)
TG_OWNER_ID=0

# Настройки Ollama (host.docker.internal — если Ollama на хосте, не в докере)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_TIMEOUT=600
LOG_LEVEL=INFO
TELETHON_LOG_LEVEL=WARNING
